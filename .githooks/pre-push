#!/bin/sh
# ExtraHorizon secret guard (pre-push): second line of defence — scans every commit
# about to be pushed for API keys, .env files and secret values from the local .env.
PATTERN='(sk-[A-Za-z0-9_-]{20,}|AIza[0-9A-Za-z_-]{35}|-----BEGIN [A-Z ]*PRIVATE KEY-----)'
ZERO=0000000000000000000000000000000000000000
root=$(git rev-parse --show-toplevel)
values=""
if [ -f "$root/.env" ]; then
  values=$(grep -E '^[A-Za-z_][A-Za-z0-9_]*(KEY|TOKEN|SECRET|PASSWORD)[A-Za-z0-9_]*=' "$root/.env" | sed -E 's/^[^=]*=//; s/^["'"'"']//; s/["'"'"']$//' | awk 'length($0) >= 16')
fi
status=0
while read local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue
  if [ "$remote_sha" = "$ZERO" ]; then range="$local_sha --not --remotes"; else range="$remote_sha..$local_sha"; fi
  for c in $(git rev-list $range); do
    if git show --format= --name-only "$c" | grep -E '(^|/)\.env($|\.)' | grep -qv -E '(^|/)\.env\.example$'; then
      echo "secret-guard: commit $c adds an env file — push blocked." >&2; status=1
    fi
    added=$(git show --format= -U0 "$c" | grep -E '^\+')
    if echo "$added" | grep -qE "$PATTERN"; then
      echo "secret-guard: commit $c contains something that looks like a secret — push blocked." >&2; status=1
    fi
    for v in $values; do
      if echo "$added" | grep -qF -- "$v"; then
        echo "secret-guard: commit $c contains a secret value from .env — push blocked." >&2; status=1
      fi
    done
  done
done
exit $status
