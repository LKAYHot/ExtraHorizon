#!/bin/sh
# ExtraHorizon secret guard (pre-commit): blocks committing API keys or .env files.
# Installed via: git config core.hooksPath .githooks   (see scripts/install_hooks.*)
PATTERN='(sk-[A-Za-z0-9_-]{20,}|AIza[0-9A-Za-z_-]{35}|-----BEGIN [A-Z ]*PRIVATE KEY-----)'

bad_files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env($|\.)' | grep -v -E '(^|/)\.env\.example$')
if [ -n "$bad_files" ]; then
  echo "secret-guard: refusing to commit env files:" >&2
  echo "$bad_files" | sed 's/^/  /' >&2
  exit 1
fi

if git diff --cached -U0 --diff-filter=ACMR | grep -E '^\+' | grep -qE "$PATTERN"; then
  echo "secret-guard: staged changes contain something that looks like an API key / private key." >&2
  echo "  Files:" >&2
  for f in $(git diff --cached --name-only --diff-filter=ACMR); do
    if git show ":$f" 2>/dev/null | grep -qE "$PATTERN"; then echo "    $f" >&2; fi
  done
  echo "  Move secrets to .env (git-ignored). Commit aborted." >&2
  exit 1
fi
exit 0
