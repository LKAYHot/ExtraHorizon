#!/bin/sh
# ExtraHorizon secret guard (pre-commit): blocks committing API keys or .env files.
# Installed via: git config core.hooksPath .githooks   (see scripts/setup.*)
PATTERN='(sk-[A-Za-z0-9_-]{20,}|AIza[0-9A-Za-z_-]{35}|-----BEGIN [A-Z ]*PRIVATE KEY-----)'

bad_files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env($|\.)' | grep -v -E '(^|/)\.env\.example$')
if [ -n "$bad_files" ]; then
  echo "secret-guard: refusing to commit env files:" >&2
  echo "$bad_files" | sed 's/^/  /' >&2
  exit 1
fi

added=$(git diff --cached -U0 --diff-filter=ACMR | grep -E '^\+')
if echo "$added" | grep -qE "$PATTERN"; then
  echo "secret-guard: staged changes contain something that looks like an API key / private key. Commit aborted." >&2
  exit 1
fi

# every secret VALUE from the local .env (whatever its format, e.g. 32-hex Fish keys)
root=$(git rev-parse --show-toplevel)
if [ -f "$root/.env" ]; then
  values=$(grep -E '^[A-Za-z_][A-Za-z0-9_]*(KEY|TOKEN|SECRET|PASSWORD)[A-Za-z0-9_]*=' "$root/.env" | sed -E 's/^[^=]*=//; s/^["'"'"']//; s/["'"'"']$//' | awk 'length($0) >= 16')
  for v in $values; do
    if echo "$added" | grep -qF -- "$v"; then
      echo "secret-guard: staged changes contain a secret value from .env. Commit aborted." >&2
      exit 1
    fi
  done
fi
exit 0
