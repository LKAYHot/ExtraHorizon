# ---------------------------------------------------------------- secrets
# Real keys live ONLY in .env (never committed). Template: .env.example
.env
.env.*
*.env
!.env.example

# ---------------------------------------------------------------- python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.coverage
htmlcov/

# ---------------------------------------------------------------- node / frontend
node_modules/
frontend/build/
frontend/.svelte-kit/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/

