# ExtraHorizon configuration template.
# Copy to `.env` (git-ignored, blocked by the secret-guard hooks) and fill in the keys.
# Every EH_* value below is optional; defaults are shown (backend/extrahorizon/config.py).

# ------------------------------------------------------------------ keys
# answers (Chat Completions) + speech-to-text (Realtime transcription)
OPENAI_API_KEY=
# the tutor's voice (Fish Audio live TTS)
FISH_API_KEY=

# ------------------------------------------------------------------ LLM
# EH_LLM_PROVIDER=openai            # "mock" = labelled offline scripted tutor (no key, no internet)
# EH_LLM_MODEL=gpt-6-luna           # chosen for the lowest time-to-first-token in our benchmark
# EH_LLM_FALLBACK_MODEL=gpt-5.5     # only if the primary model is rejected (404) before streaming
# EH_LLM_REASONING_EFFORT=none      # empty = don't send the parameter
# EH_LLM_MAX_OUTPUT_TOKENS=600
# EH_LLM_FIRST_TOKEN_TIMEOUT_S=15
# EH_LLM_IDLE_TIMEOUT_S=20
# EH_LLM_TOTAL_TIMEOUT_S=60
# EH_LLM_HISTORY_TURNS=10
# EH_PERSONA_NAME=Rika

# ------------------------------------------------------------------ voice out (Fish Audio)
# EH_TTS_ENABLED=true
# EH_TTS_PROVIDER=fish              # "mock" = labelled offline tone (tests)
# EH_FISH_MODEL=drama-3-preview     # drama-* models use wss://api.fish.audio/v1/tts/live/with-timestamp
# EH_FISH_REFERENCE_ID=c5d8a284092847df9e3c7308aeedc5f2
# EH_FISH_LATENCY=balanced          # the fast mode for drama models
# EH_TTS_SAMPLE_RATE=44100
# EH_FISH_CHUNK_LENGTH=200
# EH_FISH_TEMPERATURE=0.7
# EH_FISH_TOP_P=0.8
# EH_FISH_WARM_CONNECTIONS=1        # a connected socket waits for the next answer
# EH_TTS_MAX_LEADING_SILENCE_MS=120 # drama sometimes opens with seconds of silence …
# EH_TTS_MAX_SILENCE_MS=700         # … or plays long pauses mid-reply: capped
# EH_TTS_FIRST_CHUNK_CHARS=36       # first voice chunk may leave at a comma after this many characters
# EH_TTS_CHUNK_CHARS=140
# EH_FILLERS_ENABLED=true           # "Hmm...", "Uhh... let me see." the instant you stop talking
# EH_FILLER_MIN_UTTERANCE_MS=600

# ------------------------------------------------------------------ voice in (speech-to-text + turn-taking)
# EH_STT_PROVIDER=openai            # "mock" = scripted transcript (tests), "off" = no microphone
# EH_STT_MODEL=gpt-live-transcribe
# EH_STT_LANGUAGE=                  # empty = auto (English and Russian both work)
# EH_STT_NOISE_REDUCTION=far_field  # near_field for a headset microphone, off to disable
# EH_STT_CONTEXT_BIAS=true          # the tutor's last words go into the transcription prompt
# EH_STT_SPECULATIVE=true           # start answering on the live transcript at end of speech
# EH_VAD_THRESHOLD=0.5
# EH_VAD_MIN_SPEECH_MS=220          # this much speech opens an utterance (coughs/clicks don't)
# EH_VAD_END_SILENCE_MS=550         # this much silence ends it (comma pauses are shorter)
# EH_VAD_PREROLL_MS=400
# EH_BARGE_IN=true                  # talking over the tutor interrupts her
# EH_BARGE_IN_THRESHOLD=0.6         # stricter while her voice is audible (echo, noise)
# EH_BARGE_IN_MIN_MS=350
# EH_VOICE_MERGE_WINDOW_S=3.0       # resume within this after a pause → the same question continues

# ------------------------------------------------------------------ vision + emotion engine
# EH_VISION_ENABLED=true
# EH_MAX_FPS=12
# EH_FRAME_WIDTH=480
# EH_JPEG_QUALITY=0.8
# EH_MIN_FACE_WIDTH=0.11            # quality gates → "unknown" (never "neutral")
# EH_MAX_ABS_YAW_DEG=35
# EH_MAX_ABS_PITCH_DEG=30
# EH_MIN_BRIGHTNESS=35
# EH_EMOTION_SENSITIVITY=balanced   # calm | balanced | expressive (also switchable in the UI)
# EH_EMOTION_CALIBRATION_S=2.5      # the learner's relaxed face is learned first (per session)
# EH_EMOTION_CALIBRATION_MIN_FRAMES=15
# EH_EMOTION_ADAPT_TAU_S=60         # the baseline follows light/posture drift while the face is relaxed
# EH_EMOTION_RECALIBRATE_AFTER_S=90 # no face this long → learn the face again (someone else?)
# EH_EMOTION_REFERENCE_FPS=10
# EH_EMOTION_MAX_GAP_S=1.0          # longer without a usable face → unknown, smoothing restarts
# EH_EMOTION_HISTORY_S=60

# ------------------------------------------------------------------ server
# EH_HOST=127.0.0.1                 # keep loopback: the UI only claims "video stays on this device" then
# EH_PORT=8765
# LAN access (bound to 0.0.0.0) needs BOTH explicit lists — '*' is never accepted (DNS rebinding):
# EH_ALLOWED_HOSTS=["my-laptop.local"]
# EH_ALLOWED_ORIGINS=["http://my-laptop.local:8765"]
