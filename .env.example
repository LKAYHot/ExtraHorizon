# ExtraHorizon configuration template.
# Copy to `.env` (git-ignored, blocked by the secret-guard hooks) and fill in the key.
# Every value below is optional except the key; defaults are shown.

# ------------------------------------------------------------------ LLM (the only external service)
OPENAI_API_KEY=
# EH_LLM_PROVIDER=openai            # "mock" = labelled offline scripted tutor (no key, no internet)
# EH_LLM_MODEL=gpt-6-luna           # chosen for lowest time-to-first-token in our benchmark
# EH_LLM_FALLBACK_MODEL=gpt-5.5     # used only if the primary model is rejected (404) before streaming
# EH_LLM_REASONING_EFFORT=none      # empty = don't send the parameter
# EH_LLM_MAX_OUTPUT_TOKENS=700
# EH_LLM_FIRST_TOKEN_TIMEOUT_S=15
# EH_LLM_IDLE_TIMEOUT_S=20
# EH_LLM_TOTAL_TIMEOUT_S=60
# EH_LLM_HISTORY_TURNS=8

# ------------------------------------------------------------------ server
# EH_HOST=127.0.0.1                 # keep loopback: the UI only claims "video stays on this device" then
# EH_PORT=8765
# LAN access (bound to 0.0.0.0) needs BOTH explicit lists — '*' is never accepted (DNS rebinding):
# EH_ALLOWED_HOSTS=["my-laptop.local"]
# EH_ALLOWED_ORIGINS=["http://my-laptop.local:8765"]

# ------------------------------------------------------------------ state engine (spec: working hypotheses, tune on the real camera)
# EH_EMA_ALPHA=0.2                  # per frame at EH_EMA_REFERENCE_FPS; applied time-based
# EH_EMA_REFERENCE_FPS=10
# EH_THRESHOLD=0.65
# EH_HOLD_S=2.0                     # continuous seconds above threshold
# EH_COOLDOWN_S=15
# EH_MAX_GAP_S=0.75                 # longer gap without data = unknown (resets the hold)
# EH_RELIEF_THRESHOLD=0.45          # "decrease observed" only if measured below this ...
# EH_RELIEF_HOLD_S=2.0              # ... for this long after an adapted answer
# EH_REARM_THRESHOLD=0.55           # one event per episode: next event needs a drop below this (or a new answer)

# ------------------------------------------------------------------ vision / confusion proxy
# EH_VISION_ENABLED=true
# EH_MAX_FPS=12
# EH_FRAME_WIDTH=480
# EH_JPEG_QUALITY=0.75
# EH_CALIBRATION_S=2.5              # neutral-baseline capture per session
# EH_MIN_FACE_WIDTH=0.11
# EH_MAX_ABS_YAW_DEG=32
# EH_MAX_ABS_PITCH_DEG=28
# EH_MIN_BRIGHTNESS=40
# EH_PROXY_W_BROW=0.85
# EH_PROXY_W_LID=0.45
# EH_PROXY_W_PRESS=0.30
# EH_PROXY_SCALE_BROW=0.30
# EH_PROXY_SCALE_LID=0.30
# EH_PROXY_SCALE_PRESS=0.30
# EH_PROXY_SMILE_START=0.15
# EH_PROXY_SMILE_FULL=0.45
